{
	"name": "web-starter-day-1",
	"version": "1.0.0",
	"private": true,
	"description": "Example Node.js + TypeScript CRUD starter for expenses",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"dev:stack": "node scripts/dev-stack.mjs",
		"build": "tsc -p tsconfig.json",
		"start": "node dist/index.js",
		"format": "biome format --write .",
		"lint": "biome lint --write .",
		"check": "biome check --write .",
		"ci:check": "biome ci .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@prisma/client": "^6.19.3",
		"@types/morgan": "^1.9.10",
		"argon2": "^0.45.1",
		"bcrypt": "^5.1.1",
		"dotenv": "^17.4.2",
		"express": "^4.22.2",
		"jsonwebtoken": "^9.0.2",
		"morgan": "^1.11.0",
		"winston": "^3.19.0",
		"zod": "^4.4.3"
	},
	"vitest": {
		"environment": "node"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@types/argon2": "^0.14.1",
		"@types/bcrypt": "^5.0.2",
		"@types/express": "^5.0.3",
		"@types/jsonwebtoken": "^9.0.7",
		"@types/node": "^24.1.0",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^4.1.10",
		"prisma": "^6.19.3",
		"supertest": "^7.2.2",
		"tsx": "^4.20.4",
		"typescript": "^5.9.2",
		"vitest": "^4.1.10"
	}
}
