{
  "name": "web-starter-day-1",
  "version": "1.0.0",
  "private": true,
  "description": "Example Node.js + TypeScript CRUD starter for expenses",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "express": "^4.22.2",
    "zod": "^4.4.3"
  },
  "vitest": {
    "environment": "node"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
